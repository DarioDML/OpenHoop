{
  "expo": {
    "name": "OpenHoop",
    "slug": "openhoop",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "openhoop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.openhoop.mobile",
      "supportsTablet": false
    },
    "locales": {
      "en": "./locales/en.json",
      "nl": "./locales/nl.json"
    },
    "android": {
      "package": "app.openhoop.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0D1114",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.c2dm.permission.RECEIVE",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1114",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-localization",
      [
        "react-native-ble-manager",
        {
          "isBleRequired": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "OpenHoop uses Bluetooth to find your band and read its data. The data stays on your phone."
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0D1114"
        }
      ],
      "./plugins/withLocalNotificationsOnly",
      "./plugins/withAndroidBuildFixes",
      "./plugins/withReleaseSigning",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/barlow-condensed/700Bold/BarlowCondensed_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "OpenHoopScores",
              "label": "OpenHoop scores",
              "description": "Readiness, Sleep score and Load",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "OpenHoopOverview",
              "label": "OpenHoop overview",
              "description": "Scores with resting heart rate and HRV",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
