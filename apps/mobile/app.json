{
  "expo": {
    "name": "OpenHoop",
    "slug": "openhoop",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "openhoop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.openhoop.mobile",
      "supportsTablet": false
    },
    "locales": {
      "en": "./locales/en.json",
      "nl": "./locales/nl.json"
    },
    "android": {
      "package": "app.openhoop.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0D1114",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.WRITE_HEART_RATE",
        "android.permission.health.WRITE_RESTING_HEART_RATE",
        "android.permission.health.WRITE_HEART_RATE_VARIABILITY",
        "android.permission.health.WRITE_SLEEP",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_OXYGEN_SATURATION",
        "android.permission.health.WRITE_RESPIRATORY_RATE",
        "android.permission.health.WRITE_SKIN_TEMPERATURE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.c2dm.permission.RECEIVE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1114",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-localization",
      [
        "react-native-ble-manager",
        {
          "isBleRequired": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "OpenHoop uses Bluetooth to find your band and read its data. The data stays on your phone."
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0D1114"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OpenHoop uses your location only while you record an activity with a route, to draw the route and work out distance and pace. The route stays on your phone.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "locationFullAccuracyPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidMotionActivityEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "OpenHoop uses the camera only when you take a photo of your lab report to read its results. The photo is not kept.",
          "microphonePermission": false
        }
      ],
      "./plugins/withLocalNotificationsOnly",
      "./plugins/withAndroidBuildFixes",
      "./plugins/withReleaseSigning",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "useLegacyPackaging": true,
            "packagingOptions": {
              "exclude": ["/org/bouncycastle/pqc/**"]
            }
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/barlow-condensed/700Bold/BarlowCondensed_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "OpenHoopScores",
              "label": "OpenHoop scores",
              "description": "Readiness, Sleep score and Load",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "OpenHoopOverview",
              "label": "OpenHoop overview",
              "description": "Scores with resting heart rate and HRV",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
